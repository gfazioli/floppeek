<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Both Quick Look extensions. Quick Look runs an extension only sandboxed and
	  hands it read access to the one file it previews; Floppeek asks for nothing
	  else: no network, no other files.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
